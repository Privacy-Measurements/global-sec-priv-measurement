#### Crawl_configuration ####
BROWSER_FOR_PRECRAWL_PATH= "./resources/pagegraph_brave_build/Static/brave"
BROWSER_PATH="./resources/pagegraph_brave_build/Static/brave" ## A broswser with pagegraph
MAX_CORES=8   ## MAX_CORES to use for the crawl -- The script will chose the min between this value, and half of the system's available cores 
PROXY_PORT=8901 ## The port for the proxy server -- make sure this port is open
CRAWLING_DEPTH=5 ## How many pages to visit within a site
SAVE_SCREENSHOTS=true ## Save screenshots of the pages visited during the crawl
STORE_HAR = true ## Store HAR files for the pages visited during the crawl
MEASUREMENT_DELAY = 25 # in s -- We have 5 seconds by default in addition to this value
PAGEGRAPH_TIMEOUT = 20 
NAVIGATION_TIMEOUT = 60  ## Navigation timeout in seconds 
MAX_SITES_TO_CRAWL=10000 ## Max number of distinct sites to process in one run (0 = no cap)
MAX_TRIALS_IN_CRAWL=5 ## Maximum number of trials per URL
CRAWL_TIMEOUT_SECONDS = 180 ## Maximum time for the entire crawl in seconds
DEBUG=false

#### DATABASE CONFIGURATION ####
DB_HOST=localhost
DB_USER=cursor
DB_PASSWORD=XXX
DB_NAME=XXXXX
WEBSITE_CATEGORIZATION_whoisxmlapi_KEY=XXX













